# Safora Linux boot splash: the desktop wallpaper with the logo, name and tagline (the same layout
# as the GRUB menu), pulsing dots, and a styled disk-passphrase prompt.
# Positions are designed for 1920x1080 and scaled to the screen.

Window.SetBackgroundTopColor(0.04, 0.03, 0.08);
Window.SetBackgroundBottomColor(0.13, 0.09, 0.23);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
s = screen_h / 1080;

# Wallpaper, scaled to cover the screen and centred.
bg_image = Image("background.png");
bg_scale = Math.Max(screen_w / bg_image.GetWidth(), screen_h / bg_image.GetHeight());
bg_w = Math.Int(bg_image.GetWidth() * bg_scale + 1);
bg_h = Math.Int(bg_image.GetHeight() * bg_scale + 1);
bg_sprite = Sprite(bg_image.Scale(bg_w, bg_h));
bg_sprite.SetPosition((screen_w - bg_w) / 2, (screen_h - bg_h) / 2, -100);

fun place(file, center_y, height) {
    img = Image(file);
    w = img.GetWidth() * height / img.GetHeight();
    img = img.Scale(Math.Int(w), Math.Int(height));
    spr = Sprite(img);
    spr.SetPosition(screen_w / 2 - w / 2, center_y - height / 2, 10);
    return spr;
}

logo_sprite = place("logo.png", 250 * s, 210 * s);
# name.png / tagline.png have their baseline at 78% of the image height.
name_sprite = place("name.png", (450 - 0.28 * 96) * s, 96 * s);
tagline_sprite = place("tagline.png", (500 - 0.28 * 44) * s, 44 * s);

dot_image = Image("dot.png");
dots_y = 560 * s;
for (i = 0; i < 3; i++) {
    dot[i] = Sprite(dot_image);
    dot[i].SetPosition(screen_w / 2 + (i - 1) * 30 - dot_image.GetWidth() / 2, dots_y, 10);
    dot[i].SetOpacity(0.3);
}

frame = 0;
fun refresh_callback() {
    frame++;
    for (i = 0; i < 3; i++) {
        phase = frame / 9 - i * 0.9;
        dot[i].SetOpacity(0.25 + 0.75 * (Math.Sin(phase) + 1) / 2);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# ---- passphrase prompt
entry_image = Image("entry.png");
bullet_image = Image("bullet.png");
entry_sprite = Sprite(entry_image);
entry_x = screen_w / 2 - entry_image.GetWidth() / 2;
entry_y = 690 * s;
entry_sprite.SetPosition(entry_x, entry_y, 20);
entry_sprite.SetOpacity(0);

prompt_sprite = Sprite();
prompt_sprite.SetOpacity(0);

for (i = 0; i < 40; i++) {
    bullet[i] = Sprite(bullet_image);
    bullet[i].SetOpacity(0);
}

fun password_callback(prompt_text, bullets) {
    prompt_image = Image.Text(prompt_text, 0.93, 0.91, 0.96, 1);
    prompt_sprite.SetImage(prompt_image);
    prompt_sprite.SetPosition(screen_w / 2 - prompt_image.GetWidth() / 2, entry_y - prompt_image.GetHeight() - 14, 20);
    prompt_sprite.SetOpacity(1);
    entry_sprite.SetOpacity(1);
    for (i = 0; i < 40; i++) {
        if (i < bullets) {
            bullet[i].SetPosition(entry_x + 20 + i * 22, entry_y + entry_image.GetHeight() / 2 - bullet_image.GetHeight() / 2, 30);
            bullet[i].SetOpacity(1);
        } else {
            bullet[i].SetOpacity(0);
        }
    }
}
Plymouth.SetDisplayPasswordFunction(password_callback);

fun normal_callback() {
    prompt_sprite.SetOpacity(0);
    entry_sprite.SetOpacity(0);
    for (i = 0; i < 40; i++) bullet[i].SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(normal_callback);

# ---- status messages (errors etc.)
message_sprite = Sprite();
fun message_callback(text) {
    message_image = Image.Text(text, 0.75, 0.79, 0.96, 1);
    message_sprite.SetImage(message_image);
    message_sprite.SetPosition(screen_w / 2 - message_image.GetWidth() / 2, screen_h * 0.9, 20);
}
Plymouth.SetMessageFunction(message_callback);
