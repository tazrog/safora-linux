[Desktop Entry]
Type=Application
Name=Image Viewer
GenericName=Image Viewer
Comment=View images, zoom in and out, and browse the pictures in a folder
Exec=safora-viewer %f
TryExec=safora-viewer
Icon=safora-viewer
StartupWMClass=org.safora.Viewer
Terminal=false
StartupNotify=true
Categories=Graphics;Viewer;GTK;
Keywords=image;picture;photo;viewer;zoom;
MimeType=image/png;image/jpeg;image/gif;image/bmp;image/x-bmp;image/webp;image/tiff;image/svg+xml;image/svg+xml-compressed;image/x-icon;image/vnd.microsoft.icon;image/avif;image/heic;image/heif;image/jxl;image/x-tga;image/x-portable-pixmap;image/x-portable-graymap;image/x-portable-bitmap;image/x-portable-anymap;image/x-xpixmap;image/x-xbitmap;image/qoi;
