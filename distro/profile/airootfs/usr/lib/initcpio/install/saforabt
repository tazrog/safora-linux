#!/bin/bash
# mkinitcpio hook: lets a previously paired Bluetooth keyboard type the disk passphrase.
# Inert unless the installer created /etc/saforabt/enabled.
#
# SECURITY NOTE: the pairing key has to live inside the (unencrypted) initramfs on /boot so the
# keyboard can reconnect before the disk is unlocked. Anyone who can read /boot can learn that key.

build() {
    if [[ ! -f /etc/saforabt/enabled ]]; then
        return 0
    fi

    local m
    # cmac/ccm/aes/ecdh: the Bluetooth stack loads these on demand (request_module) for LE pairing
    # security (SMP) and Secure Simple Pairing. They are not hard module dependencies, so without
    # them a Bluetooth LE keyboard can connect but its encrypted HID channel never comes up.
    for m in bluetooth btusb btintel btbcm btrtl btmtk btmtksdio hci_uart hidp uhid hid-generic evdev \
             cmac ccm aes_generic aesni_intel ecdh_generic ecc rfkill; do
        add_module "$m" 2>/dev/null || true
    done
    # Vendor HID drivers (Logitech, Apple, Microsoft, ...), so keyboards that need them work too.
    add_checked_modules '/drivers/hid/' 2>/dev/null || true

    add_binary /usr/lib/bluetooth/bluetoothd
    add_binary /usr/bin/bluetoothctl
    add_binary /usr/bin/dbus-daemon

    # udev must label the new input device as a keyboard (ID_INPUT_KEYBOARD) or plymouth's password
    # prompt won't listen to it.
    add_udev_rule 60-input-id.rules
    add_udev_rule 70-uaccess.rules 2>/dev/null || true

    [[ -f /etc/bluetooth/main.conf ]] && add_file /etc/bluetooth/main.conf
    [[ -f /etc/bluetooth/input.conf ]] && add_file /etc/bluetooth/input.conf
    add_file /etc/saforabt/dbus.conf /etc/saforabt/dbus.conf
    add_file /etc/saforabt/devices /etc/saforabt/devices

    # Adapter firmware (recorded by /usr/lib/safora/saforabt-firmware when the feature was switched on).
    # Without it many adapters don't come up after a cold start, so the keyboard could never connect.
    while IFS= read -r f; do
        [[ $f == /usr/lib/firmware/* && -f $f ]] && add_file "$f"
    done < <(cat /etc/saforabt/firmware 2>/dev/null; /usr/lib/safora/saforabt-firmware 2>/dev/null)

    local f
    while IFS= read -r -d '' f; do
        add_file "$f" "/var/lib/bluetooth/${f#/etc/saforabt/state/}"
    done < <(find /etc/saforabt/state -type f -print0 2>/dev/null)

    add_runscript
}

help() {
    cat <<HELPEOF
Starts a minimal Bluetooth stack in early userspace so a paired keyboard can unlock the disk.
Enabled by the Safora installer; see /etc/saforabt/.
HELPEOF
}
