#!/bin/bash
# Root-side helper for Safora Settings. Runs only through sudo, validates every argument, and does one thing per call.
#   safora-sysconf set-timezone Europe/Berlin
#   safora-sysconf set-ntp on|off
#   safora-sysconf set-locale en_US.UTF-8
#   safora-sysconf user-add NAME admin|user      (password: stdin line "SAFORA:<password>")
#   safora-sysconf user-passwd NAME              (password: stdin line "SAFORA:<password>")
#   safora-sysconf user-admin NAME on|off
#   safora-sysconf user-del NAME
set -euo pipefail
umask 022
[[ $EUID -eq 0 ]] || { echo "must run as root" >&2; exit 1; }

fail() { echo "$*" >&2; exit 1; }
name_ok() { [[ $1 =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || fail "invalid account name"; }
secret() {
    local line
    while IFS= read -r line; do
        [[ $line == SAFORA:* ]] && { printf '%s' "${line#SAFORA:}"; return; }
    done
    fail "no password supplied"
}
min_uid() { awk '/^UID_MIN/ {print $2}' /etc/login.defs 2>/dev/null || echo 1000; }
regular_user() { # exists and is a normal (non-system) account
    local uid; uid=$(id -u "$1" 2>/dev/null) || fail "no such account"
    (( uid >= $(min_uid) && uid < 60000 )) || fail "not a regular account"
}

cmd=${1:-}; shift || true
case $cmd in
set-timezone)
    [[ ${1:-} =~ ^[A-Za-z0-9_+/-]+$ && -f /usr/share/zoneinfo/$1 ]] || fail "unknown time zone"
    timedatectl set-timezone "$1" ;;
set-ntp)
    [[ ${1:-} == on || ${1:-} == off ]] || fail "expected on or off"
    if [[ $1 == on ]]; then timedatectl set-ntp true; else timedatectl set-ntp false; fi ;;
set-locale)
    loc=${1:-}
    [[ $loc =~ ^[a-z]{2,3}(_[A-Z]{2})?(@[a-z]+)?\.UTF-8$ ]] || fail "invalid locale"
    grep -q "^#\?$loc UTF-8" /etc/locale.gen || fail "locale not available"
    sed -i "s/^#\($loc UTF-8\)/\1/" /etc/locale.gen
    locale-gen >/dev/null
    printf 'LANG=%s\n' "$loc" > /etc/locale.conf ;;
user-add)
    name_ok "${1:-}"; [[ ${2:-} == admin || ${2:-} == user ]] || fail "expected admin or user"
    id "$1" &>/dev/null && fail "that name is already taken"
    pw=$(secret); [[ ${#pw} -ge 1 ]] || fail "empty password"
    useradd -m -s /bin/bash -G users "$1"
    [[ $2 == admin ]] && gpasswd -a "$1" wheel >/dev/null
    chmod 700 "/home/$1"
    printf '%s:%s\n' "$1" "$pw" | chpasswd ;;
user-passwd)
    name_ok "${1:-}"; regular_user "$1"
    pw=$(secret); [[ ${#pw} -ge 1 ]] || fail "empty password"
    printf '%s:%s\n' "$1" "$pw" | chpasswd ;;
user-admin)
    name_ok "${1:-}"; regular_user "$1"; [[ ${2:-} == on || ${2:-} == off ]] || fail "expected on or off"
    [[ $1 != "${SUDO_USER:-}" ]] || fail "you cannot change your own administrator status"
    if [[ $2 == on ]]; then gpasswd -a "$1" wheel >/dev/null; else gpasswd -d "$1" wheel >/dev/null; fi ;;
user-del)
    name_ok "${1:-}"; regular_user "$1"
    [[ $1 != "${SUDO_USER:-}" ]] || fail "you cannot remove the account you are using"
    userdel -r "$1" ;;
*) fail "unknown command" ;;
esac
