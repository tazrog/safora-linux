#!/bin/bash
# Install Claude Code (Anthropic's command-line assistant) for the current user with Anthropic's
# native installer (https://claude.ai/install.sh). Needs a network connection; no root, nodejs or npm.
# It lands in ~/.local/bin/claude and keeps itself up to date.
set -eo pipefail
if [ "$(id -u)" -eq 0 ]; then
    echo "Run this as your normal user, not root: Claude Code is installed per user." >&2
    exit 1
fi
echo "Installing Claude Code from https://claude.ai/install.sh ..."
curl -fsSL https://claude.ai/install.sh | bash
echo "Done. Open a new terminal and run:  claude"
