#!/bin/sh
# Start a Safora session. Run by greetd (as the logged-in user) or from a TTY.
#   safora-session          normal desktop
#   safora-session --live   live medium: also launch the installer
umask 077
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=Safora XDG_SESSION_DESKTOP=Safora
export XCURSOR_THEME="${XCURSOR_THEME:-Adwaita}" XCURSOR_SIZE="${XCURSOR_SIZE:-24}"
export GTK_USE_PORTAL=0
export MOZ_ENABLE_WAYLAND=1 QT_QPA_PLATFORM=wayland ELECTRON_OZONE_PLATFORM_HINT=wayland
export _JAVA_AWT_WM_NONREPARENTING=1

[ -n "$XDG_RUNTIME_DIR" ] || { echo "safora-session: no XDG_RUNTIME_DIR (is logind running?)" >&2; exit 1; }

logdir="${XDG_STATE_HOME:-$HOME/.local/state}/safora"
mkdir -p "$logdir"

# Low RAM boot (boot menu entry "Low RAM - local AI", kernel parameter safora.lowram): the compositor
# opens just a terminal; no bar, no startup programs. Network, sound and Bluetooth are not started.
if grep -qwF safora.lowram /proc/cmdline 2>/dev/null; then
    export SAFORA_LOWRAM=1
fi

live=0
[ "${1:-}" = "--live" ] && live=1
set --
[ $live = 1 ] && set -- --exec safora-installer
# In VirtualBox, follow the VM window size (full-screen mode, window resizing).
if [ "$(systemd-detect-virt 2>/dev/null)" = "oracle" ] && command -v VBoxDRMClient >/dev/null 2>&1; then
    set -- "$@" --exec VBoxDRMClient
fi

# Use the user's session bus (started by systemd at login) so the desktop, the keyring (unlocked by
# the login password; stores "Remember forever" passwords, e.g. for encrypted USB drives) and the
# drive helpers of the file manager all meet on one bus. Services that D-Bus starts later (keyring
# password prompts, ...) must learn which display to use, hence the activation-environment update.
if [ -S "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
    exec saforawm "$@" \
        --exec "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE GDK_BACKEND MOZ_ENABLE_WAYLAND QT_QPA_PLATFORM" \
        >"$logdir/saforawm.log" 2>&1
fi
# No user bus (e.g. started without logind/systemd --user): a private one for this session.
exec dbus-run-session -- saforawm "$@" >"$logdir/saforawm.log" 2>&1
